# --- Backend (copy to .env) ---
ENVIRONMENT=development            # set to "production" when deployed (enforces safe config)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# key:tier pairs. Generate keys with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Required in production. Leave empty locally to run without auth as DEV_DEFAULT_TIER.
API_KEYS=
DEV_DEFAULT_TIER=pro
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_PATH=./data/seo_agent.db  # on Railway use a volume path, e.g. /data/seo_agent.db
RATE_LIMIT_PER_MINUTE=10
MAX_CONCURRENT_RUNS=3
FREE_DAILY_RUNS=5                  # runs per day per API key on the free plan
PRO_DAILY_RUNS=100
SERPER_API_KEY=                    # optional: real Google competitor research (Pro). Get one at serper.dev
SERP_COUNTRY=us
SERP_CACHE_HOURS=24
LLM_MAX_RETRIES=3
# --- AI providers (add the keys you have; all optional except one) ---
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Default model chain. You can also change it in the app under AI settings (saved in the database).
# Format provider:model, e.g. AI_PRIMARY=gemini:gemini-2.5-flash  AI_FALLBACKS=groq:openai/gpt-oss-20b,openai:gpt-5.4-nano
AI_PRIMARY=
AI_FALLBACKS=
AI_DEADLINE_SECONDS=240            # overall time limit for one AI task across all models
# Keys (from API_KEYS) allowed to change AI settings. Leave empty to make settings read-only.
ADMIN_API_KEYS=
LLM_MIN_INTERVAL_SECONDS=0         # set to 13 on the Gemini FREE tier (5 requests per minute)
LLM_TIMEOUT_SECONDS=90
LOG_LEVEL=INFO
